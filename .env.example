# Скопируйте в .env и заполните. Файл .env в git не попадает.

# --- база данных ---
POSTGRES_DB=smena
POSTGRES_USER=smena
POSTGRES_PASSWORD=CHANGE_ME
DB_PORT=5433

# --- API ---
JWT_SECRET=CHANGE_ME_LONG_RANDOM_STRING
API_PORT=3000

# Первый вход руководителя. Создаётся один раз при пустой базе.
ADMIN_PHONE=79990000000
ADMIN_PASSWORD=CHANGE_ME
ADMIN_LAST_NAME=Мукозобов
ADMIN_FIRST_NAME=Дмитрий

# --- сайт ---
# локально ":80"; на сервере — ваш домен, например "smena.example.ru"
SITE_ADDRESS=:80
WEB_PORT=8080
WEB_TLS_PORT=8443
# пусто = фронт обращается на тот же адрес, откуда открыт
VITE_API_URL=
